          "id": "cf",
          "url": "https://www2.camara.leg.br/legin/fed/consti/1988/constituicao-1988-5-outubro-1988-322142-normaatualizada-pl.html",
          "locator": "Constituição Federal, arts. 23, 24, 30 e 225, nos recortes da edição original",
          "consultedAt": "2026-11-20",
          "status": "parcial",
          "scope": "Conferência declarada na edição original; não revalidada pelo compilador",
          "revision": "1"
        }
      ],
